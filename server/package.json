{
  "name": "medflow-server",
  "version": "1.0.0",
  "description": "MedFlow Hospital Management Platform - Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
